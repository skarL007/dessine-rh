# Production: pooled Postgres connection from the chosen provider.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Local validation only. Vercel refuses local persistence.
APP_ENV=local
PGLITE_DIR=.data/local
PORT=3000
# Set temporarily when running npm run db:seed; never a production credential.
SEED_ADMIN_PASSWORD=
